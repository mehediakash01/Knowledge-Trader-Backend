# ============================================================================
# Knowledge Trader Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database (PostgreSQL via Prisma)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_trader_dev"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_EXPIRE_IN="24h"
JWT_REFRESH_EXPIRE_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# AI Gateway Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
AI_TIMEOUT_MS=30000

# AI Rate Limiting (per user per hour)
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_MS=3600000

# Email Configuration (for notifications - optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Socket.io Configuration
SOCKET_CORS_ORIGIN="http://localhost:3000"
SOCKET_PORT=5001

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs/app.log"

# Seed Data (set to true to run seed on startup in development)
RUN_SEED_ON_STARTUP=false
